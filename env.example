# ⚠️ БҰЛ ФАЙЛ — ТЕК ҮЛГІ. НАҚТЫ ТОКЕН/ПАРОЛЬДЕРДІ МҰНДА ЖАЗБАҢЫЗ.
# Нақты мәндерді тек өзіңіздің жергілікті `.env` файлыңызда сақтаңыз,
# ол `.gitignore`-де тұр және ешқашан Git-ке commit жасалмауы керек.

# Telegram
BOT_TOKEN=your_bot_token_here

# Google Sheets (мәліметтер осында сақталады)
# credentials.json файлын жобаның түбір папкасына қойыңыз (немесе жолын өзгертіңіз)
GOOGLE_CREDENTIALS_PATH=credentials.json
# Таблица URL-і: https://docs.google.com/spreadsheets/d/<ОСЫ_ЖЕР>/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SHEET_NAME=Sheet1
# Windows-та ғана қажет, tesseract.exe PATH-та болмаса:
TESSERACT_CMD=

# OCR: "tesseract" немесе "easyocr"
OCR_ENGINE=tesseract
OCR_LANGUAGES=rus+eng

# Диспетчер ретінде тіркелу үшін логин/пароль (осыны күшті, бірегей етіп қойыңыз)
ADMIN_LOGIN=change_me
ADMIN_PASSWORD=change_me_to_a_strong_password

# Database (заказдардың қайталанбауын тексеру үшін)
DATABASE_PATH=orders.db
MIN_PACKAGES_FOR_AUTO_ACCEPT=5

# Logging
LOG_LEVEL=INFO
