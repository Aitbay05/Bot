# Telegram
BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Sheets (мәліметтер осында сақталады)
# 1) Google Cloud Console-да Service Account жасап, JSON кілт файлын жүктеп алыңыз
# 2) Сол JSON файлды жоба папкасына credentials.json деп сақтаңыз
# 3) Google Таблицаны сол Service Account-тың email-іне "Редактор" ретінде ортақ қылыңыз
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_SHEET_ID=1AbCдефGhIjKlMnOpQrStUvWxYz_осы_жерге_өз_таблицаңыздың_id-ін_жазыңыз
GOOGLE_SHEET_NAME=Sheet1

# OCR: "tesseract" немесе "easyocr"
OCR_ENGINE=tesseract
OCR_LANGUAGES=rus+eng

# Database (заказдардың қайталанбауын тексеру үшін)
DATABASE_PATH=orders.db

# Диспетчер / /admin командасы үшін логин-пароль.
# Диспетчер осы логин-парольді Telegram-да /admin командасынан кейін енгізеді.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change_me

# Осы саннан КОП пакет болса — автоматты қабылданады.
# Осы санға ТЕҢ немесе одан АЗ болса — диспетчерге жіберіледі.
MIN_PACKAGES_FOR_AUTO_ACCEPT=5

# Logging
LOG_LEVEL=INFO
